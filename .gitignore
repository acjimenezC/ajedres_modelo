.agents/

# ---------------------------------------------------------------------------
# Datos
# ---------------------------------------------------------------------------
# El dataset crudo se descarga de Kaggle con `python -m src.data_loader`,
# por eso se ignora (es pesado y regenerable).
data/raw/

# El dataset procesado se regenera con el mismo comando. Descoméntalo si
# NO quieres subirlo al repositorio:
# data/processed/dataset.csv

# ---------------------------------------------------------------------------
# Modelos y artefactos entrenados
# ---------------------------------------------------------------------------
# Se MANTIENEN en el repo como evidencia de la entrega (best_model.pkl,
# model_metadata.json) para que el evaluador no tenga que reentrenar.
# Si prefieres NO subir el modelo binario, descomenta la línea siguiente:
# models/best_model.pkl

# ---------------------------------------------------------------------------
# Credenciales / secretos (nunca subir)
# ---------------------------------------------------------------------------
.env
*.env
secrets.json
credentials.json
*.key
